{
  "name": "@tulip/mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "Local stdio MCP server exposing client theme tokens and taste-governed component compilation",
  "type": "module",
  "bin": {
    "tulip-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "smoke": "npm run build && node scripts/smoke.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
