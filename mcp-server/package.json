{
  "name": "@tulip/mcp-server",
  "version": "0.3.0",
  "private": true,
  "description": "Tulip MCP server: client theme tokens and taste-governed component compilation over stdio or Streamable HTTP",
  "type": "module",
  "bin": {
    "tulip-mcp": "dist/index.js",
    "tulip-mcp-http": "dist/http.js"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/http-main.ts",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "start:http:local": "node --env-file=.env dist/http.js",
    "typecheck": "tsc --noEmit",
    "smoke": "npm run build && node scripts/smoke.mjs && node scripts/smoke-http.mjs",
    "create-api-key": "node scripts/create-api-key.mjs",
    "verify": "node scripts/verify-manifest.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "@modelcontextprotocol/sdk": "1.31.0",
    "hono": "4.13.12",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
