{
  "version": 1,
  "colors": {
    "primary": {
      "50": "#eff6ff", "100": "#dbeafe", "200": "#bfdbfe", "300": "#93c5fd",
      "400": "#60a5fa", "500": "#3b82f6", "600": "#2563eb", "700": "#1d4ed8",
      "800": "#1e40af", "900": "#1e3a8a", "950": "#172554"
    },
    "secondary": {
      "50": "#fffbeb", "100": "#fef3c7", "200": "#fde68a", "300": "#fcd34d",
      "400": "#fbbf24", "500": "#f59e0b", "600": "#d97706", "700": "#b45309",
      "800": "#92400e", "900": "#78350f", "950": "#451a03"
    }
  },
  "typography": {
    "heading": ["Inter Display", "Inter", "system-ui"],
    "body": ["Inter", "Helvetica Neue", "sans-serif"],
    "mono": ["JetBrains Mono", "ui-monospace"]
  },
  "radius": { "sm": "0.25rem", "md": "0.5rem", "lg": "0.75rem", "xl": "1rem" },
  "components": {
    "button": { "--button-radius": "{radius.md}" },
    "card": { "--card-padding": "1.5rem", "--card-accent": "{colors.secondary.500}" },
    "dialog": { "--dialog-radius": "{radius.xl}" },
    "navbar": { "--navbar-font": "{typography.heading}" }
  }
}
