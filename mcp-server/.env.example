# Local configuration for the HTTP server (npm run start:http:local).
# Copy to mcp-server/.env, which is gitignored, and fill in the secret.

# tulip-db
SUPABASE_URL=https://pdwtxnngciqdjbylyntk.supabase.co
# Supabase dashboard → Project settings → API keys → service_role / secret key.
SUPABASE_SERVICE_ROLE_KEY=

# 3333 keeps clear of the Next dev server on 3000; must match .cursor/mcp.json.
PORT=3333
HOST=127.0.0.1

# Short cache locally so revoking a key takes effect quickly.
API_KEY_CACHE_TTL_MS=5000

# Development only: serve mcp-server/tokens/*.json for clients with nothing
# published in tulip-db yet (e.g. demo). Published tokens always win.
# Never set this on Render.
TULIP_TOKENS_FALLBACK_DIR=./tokens
